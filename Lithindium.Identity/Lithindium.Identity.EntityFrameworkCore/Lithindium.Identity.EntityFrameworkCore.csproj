<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Title>Lithindium Identity EF Core</Title>
        <PackageId>Lithindium.Identity.EntityFrameworkCore</PackageId>
        <Version>1.0.0</Version>
        <Authors>Visual Fire Development LLC</Authors>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/visualfiredev/lithindium-identity.git</RepositoryUrl>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>true</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Lithindium.Identity/Lithindium.Identity.csproj" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" PrivateAssets="all" />
    </ItemGroup>
</Project>
